# Run npm run setup to create .env.local without manually writing code.
APP_URL=http://127.0.0.1:3000
BUSINESS_TIMEZONE=Asia/Aden
BUSINESS_OPEN=9
BUSINESS_CLOSE=17
BUSINESS_DAYS=0,1,2,3,4
DATABASE_URL=
# TLS validation remains enabled. Optional PEM path for a private CA.
DATABASE_CA_FILE=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
TOOL_SECRET=
INGEST_SECRET=
N8N_WEBHOOK_SECRET=
N8N_URL=http://127.0.0.1:5678
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/agentflow-chat
N8N_API_KEY=
GEMINI_API_KEY=
# Choose a model available to YOUR account. No claim of universal availability.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_MIN_SIMILARITY=0.60
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_MODE=socket
SLACK_HANDOFF_CHANNEL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_GRAPH_VERSION=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
# Local webhook ingress only; point a HTTPS tunnel at this port, NOT port 3000/5678.
INGRESS_PORT=8787
ENABLE_PREVIEW=true
